{
  "name": "claude-usage-status",
  "publisher": "local-dev",
  "displayName": "Claude Usage Status",
  "description": "Live session and weekly usage graph for your Claude plan, in the status bar.",
  "version": "0.0.7",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsageStatus.openDetail",
        "title": "Claude Usage: Show Detail"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
